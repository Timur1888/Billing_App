<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="manageVariantDialog"
        title="Ansichten verwalten"
        stretchOnPhone="true"
        contentWidth="900px">

        <!-- Suchleiste oben -->
        <VBox class="sapUiSmallMargin">
            <SearchField
                width="100%"
                placeholder="Suchen"
                liveChange=".onManageSearch"
                search=".onManageSearch"/>

            <Table
                id="tblManageVariants"
                items="{
                    path: 'variantManage>/views'
                }">

                <columns>
                    <Column><Text text="Ansicht"/></Column>
                    <Column><Text text="Freigegeben"/></Column>
                    <Column><Text text="Standard"/></Column>
                    <Column><Text text="Automatisch anwenden"/></Column>
                    <Column><Text text="Angelegt von"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>

                            <HBox width="100%">
                                <items>
                                    <core:Icon
                                        src="sap-icon://favorite"
                                        class="sapUiTinyMarginEnd" />
                                    <Input
                                        value="{variantManage>name}"
                                        width="100%" />
                                </items>
                            </HBox>

                            <Text text="{= ${variantManage>isPublic} ? 'Öffentlich' : 'Privat' }"/>

                            <RadioButton
                                groupName="variantDefault"
                                selected="{variantManage>isDefault}"
                                select=".onVariantDefaultToggle"/>

                            <HBox width="100%">
                                <items>
                                    <CheckBox
                                        selected="{variantManage>autoApply}"/>
                                    <Text
                                        class="sapUiTinyMarginBegin"
                                        wrapping="true"
                                        visible="{variantManage>autoApply}"
                                        text="Wenn voreingestellte Filterwerte verfügbar sind, lädt der Inhalt automatisch."/>
                                </items>
                            </HBox>

                            <HBox width="100%" justifyContent="SpaceBetween">
                                <items>
                                    <Text text="{variantManage>createdBy}"/>
                                    <Button
                                        icon="sap-icon://decline"
                                        type="Transparent"
                                        tooltip="Ansicht löschen"
                                        visible="{= !${variantManage>isDefault} }"
                                        press=".onVariantDelete"/>
                                </items>
                            </HBox>

                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </VBox>

        <beginButton>
            <Button
                text="Sichern"
                type="Emphasized"
                press=".onManageSave"/>
        </beginButton>

        <endButton>
            <Button
                text="Abbrechen"
                press=".onCloseManageDialog"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
