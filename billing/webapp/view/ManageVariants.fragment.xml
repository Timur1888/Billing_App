<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="manageVariantDialog"
        title="Ansichten verwalten"
        stretchOnPhone="true"
        contentWidth="900px">

        <!-- Suchleiste oben -->
        <VBox class="sapUiSmallMargin">
            <SearchField
                width="100%"
                placeholder="Suchen"
                liveChange=".onManageSearch"
                search=".onManageSearch"/>

            <Table
                id="tblManageVariants"
                items="{
                    path: 'variant>/views'
                }">

                <columns>
                    <Column><Text text="Ansicht"/></Column>
                    <Column><Text text="Freigegeben"/></Column>
                    <Column><Text text="Standard"/></Column>
                    <Column><Text text="Automatisch anwenden"/></Column>
                    <Column><Text text="Angelegt von"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>

                            <HBox width="100%">
                                <items>
                                    <core:Icon
                                        src="sap-icon://favorite"
                                        class="sapUiTinyMarginEnd" />
                                    <Input
                                        value="{variant>name}"
                                        width="100%" />
                                </items>
                            </HBox>


                            <!-- Freigegeben: Öffentlich / Privat -->
                            <Text
                                text="{= ${variant>isPublic} ? 'Öffentlich' : 'Privat' }"/>

                            <!-- Standard: Radiobutton wie im Original -->
                            <RadioButton
                                groupName="variantDefault"
                                selected="{variant>isDefault}"
                                select=".onVariantDefaultToggle"/>

                            <!-- Automatisch anwenden: Checkbox + Text nur wenn aktiv -->
                            <HBox width="100%">
                                <CheckBox
                                    selected="{variant>autoApply}"/>
                                <Text
                                    class="sapUiTinyMarginBegin"
                                    wrapping="true"
                                    visible="{variant>autoApply}"
                                    text="Wenn voreingestellte Filterwerte verfügbar sind, lädt der Inhalt automatisch."/>
                            </HBox>

                            <!-- Angelegt von + X zum Löschen -->
                            <HBox width="100%" justifyContent="SpaceBetween">
                                <Text text="{variant>createdBy}"/>
                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    tooltip="Ansicht löschen"
                                    visible="{= !${variant>isDefault} }"
                                    press=".onVariantDelete"/>
                            </HBox>

                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </VBox>

        <beginButton>
            <Button
                text="Sichern"
                type="Emphasized"
                press=".onManageSave"/>
        </beginButton>

        <endButton>
            <Button
                text="Abbrechen"
                press=".onCloseManageDialog"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
