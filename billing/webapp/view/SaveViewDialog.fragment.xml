<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="dlgSaveView"
        title="Ansicht sichern">
        <VBox class="sapUiSmallMargin">
            <Label text="Ansicht" labelFor="inpViewName" />
            <Input
                id="inpViewName"
                value="{variant>/newView/name}"
                placeholder="Name der Ansicht" />

            <CheckBox
                text="Als Standard festlegen"
                selected="{variant>/newView/isDefault}" />
            <CheckBox
                text="Öffentlich"
                selected="{variant>/newView/isPublic}" />
            <CheckBox
                text="Automatisch anwenden"
                selected="{variant>/newView/autoApply}" />
        </VBox>

        <beginButton>
            <Button
                text="Sichern"
                press=".onConfirmSaveView" />
        </beginButton>
        <endButton>
            <Button
                text="Abbrechen"
                press=".onCancelSaveView" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
