<mvc:View
    controllerName="billing.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants">

    <f:DynamicPage
        id="dpBilling"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true">

        <!-- ====== TITLE AREA (immer sichtbar) ====== -->
        <f:title>
            <f:DynamicPageTitle id="dptTitle">

                <f:heading>
                    <svm:SmartVariantManagement id="svm" showExecuteOnSelection="true" />
                </f:heading>
                	<f:expandedContent>
						<Label id="expandedLabel" text="No filters active" />
					</f:expandedContent>
					<f:snappedContent>
						<Label id="snappedLabel" text="No filters active" />
					</f:snappedContent>

                <!-- Actions rechts wie vorher im OverflowToolbar -->
                <f:actions>

                    <Button
                        id="btnCreate"
                        text="Create"
                        type="Emphasized"
                        class="myCreateBtn"
                        press=".onCreate" />

                    <Button
                        id="btnDelete"
                        icon="sap-icon://delete"
                        press=".onDelete"
                        tooltip="Delete selected"
                        enabled="false" />

                    <Button
                        id="btnRefresh"
                        icon="sap-icon://refresh"
                        press="onReload"
                        type="Transparent" />

                    <Button
                        id="btnSettings"
                        icon="sap-icon://action-settings"
                        press=".onSettings" />
                </f:actions>

            </f:DynamicPageTitle>
        </f:title>

        <!-- ====== COLLAPSIBLE / PINNABLE HEADER ====== -->
        <f:header>
            <f:DynamicPageHeader id="dphHeader" pinnable="true">
                <f:content>
                <!-- Hier ist der Bereich wie im Screenshot (Filter + Search) -->
               <fb:FilterBar id="filterbar" persistencyKey="myPersKey" 
               useToolbar="false" search=".onSearch" 
               filterChange=".onFilterChange" 
               afterVariantLoad=".onAfterVariantLoad">
                    <fb:filterGroupItems>

                        <!-- Quick Search (entspricht deinem SearchField) -->
                        <fb:FilterGroupItem
                            id="fgiQuickSearch"
                            groupName="Group1"
                            name="Search"
                            label="Search"
                            visibleInFilterBar="true">
                            <fb:control>
                                <SearchField
                                    id="sfSearch"
                                    width="18rem"
                                    placeholder="Search"
                                    search=".onSearch" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        

                        <!-- ====== Status ====== -->
                        <fb:FilterGroupItem
                            id="fgiStatus"
                            name="State"
                            label="Status"
                            groupName="Group1"
                            visibleInFilterBar="true">
                            <fb:control>
                            <MultiComboBox
                            id="mcbStatus"
                            name="State"
                            selectionChange=".onFilterSelectionChange"
                            items="{ path: 'fb>/StatusList', templateShareable: true }">
                            <core:Item id ="State" key="{fb>key}" text="{fb>text}" />
                            </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <!-- ====== Recipient name ====== -->
                        <fb:FilterGroupItem
                            id="fgiRecipientName"
                            name="RecipientName"
                            label="Recipient Name"
                            groupName="Group1"
                            visibleInFilterBar="true">
                            <fb:control>
                            <MultiComboBox
                            id="mcbRecipient"
                            name="RecipientName"
                            selectionChange=".onFilterSelectionChange"
                            items="{ path: 'fb>/RecipientNameList', templateShareable: true }">
                            <core:Item id="RecipientName" key="{fb>key}" text="{fb>text}" />
                            </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- ====== InvoiceNo ====== -->
                        <fb:FilterGroupItem
                        id="fgiInvoiceNo"
                        name="InvoiceNo"
                        label="Invoice No."
                        groupName="Group1"
                        visibleInFilterBar="true">
                        <fb:control>

                        <MultiInput
                            id="multiInput"
                            width="60%"
                            valueHelpRequest=".onValueHelpRequested"
                            tokenChange=".onInvoiceNoTokenUpdate"
                            suggestionRows="{
                                path: 'fb>/InvoiceNumberList',
                                length: 10
                            }">
                            <suggestionColumns>
                                <Column id="colSugInvNo">
                                    <Label id="lblSugInvNo" text="Invoice No."/>
                                </Column>
                                <Column id="colSugInvRecName">
                                    <Label id="lblSugInvRecName" text="Recipient Name"/>
                                </Column>
                            </suggestionColumns>

                            <suggestionRows>
                                <ColumnListItem id="cliSugInvNo">
                                    <Label id="lblSugInvNoVal" text="{fb>InvoiceNo}" />
                                    <Label id="lblSugInvRecNameVal" text="{fb>RecipientName}" />
                                </ColumnListItem>
                            </suggestionRows>
                        </MultiInput>

                        </fb:control>
                    </fb:FilterGroupItem>
                        
                    </fb:filterGroupItems>
                </fb:FilterBar>
        </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- ====== CONTENT ====== -->
        <f:content>

            <Table
                id="tblBilling"
                inset="false"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                mode="MultiSelect"
                items="{backend>/value}"
                itemPress=".onInvoicePress"
                selectionChange=".onSelectionChange">

                <columns>
                    <Column id="colStatus"><Text id="txtColStatus" text="Status"/></Column>
                    <Column id="colRecipientName"><Text id="txtColRecipientName" text="Recipient Name"/></Column>
                    <Column id="colRecipientEmail"><Text id="txtColRecipientEmail" text="Recipient Email"/></Column>
                    <Column id="colInvoiceType" hAlign="Center"><Text id="txtColInvoiceType" text="Invoice Type"/></Column>
                    <Column id="colInvoiceNo"><Text id="txtColInvoiceNo" text="Invoice No."/></Column>
                    <Column id="colNettoValue" hAlign="End"><Text id="txtColNettoValue" text="Netto Value"/></Column>
                    <Column id="colBruttoValue" hAlign="End"><Text id="txtColBruttoValue" text="Brutto Value"/></Column>
                    <Column id="colCcy"><Text id="txtColCcy" text="CCY"/></Column>
                    <Column id="colSalesOrg"><Text id="txtColSalesOrg" text="Sales Org"/></Column>
                    <Column id="colFacturaDate"><Text id="txtColFacturaDate" text="Factura Date"/></Column>
                    <Column id="colCreationDate"><Text id="txtColCreationDate" text="Creation Date"/></Column>
                    <Column id="colDispatchDate"><Text id="txtColDispatchDate" text="Dispatch Date"/></Column>
                    <Column id="colTransferFormat"><Text id="txtColTransferFormat" text="Transfer Format"/></Column>
                    <Column id="colDeliveryMethod"><Text id="txtColDeliveryMethod" text="Delivery Method"/></Column>
                    <Column id="colDeliveryId"><Text id="txtColDeliveryId" text="Delivery ID"/></Column>
                    <Column id="colPdf"><Text id="txtColPdf" text="PDF"/></Column>
                </columns>

                <items>
                    <ColumnListItem id="cliBilling" type="Active">
                        <cells>

                            <!-- Status -->
                            <ObjectStatus
                                id="osState"
                                text=""
                                icon="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusIcon'
                                }"
                                state="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusState'
                                }"
                            />

                            <!-- Recipient Name -->
                            <Text id="txtRecipientName" text="{backend>MetaData/Object/Data/Basics/Recipient/Name}" />

                            <!-- Recipient Email -->
                            <Text id="txtRecipientEmail" text="{backend>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />

                            <!-- Invoice Type -->
                            <Text id="txtInvoiceType" text="{
                                path: 'backend>MetaData/Object/Data/Type',
                                formatter: '.formatter.formatInvoiceType'
                            }" />

                            <!-- Invoice No. -->
                            <Text id="txtInvoiceNo" text="{backend>MetaData/Object/Data/Basics/Number/Value}" />

                            <!-- Netto -->
                            <ObjectNumber
                                id="onNetto"
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Net/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- Brutto -->
                            <ObjectNumber
                                id="onBrutto"
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Gross/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- CCY -->
                            <Text id="txtCcyCell" text="{
                                path: 'backend>MetaData/Object/Data/Amounts/Currency/Value',
                                formatter: '.formatter.formatCurrency'
                            }" />

                            <!-- Sales Org -->
                            <Text id="txtSalesOrgCell" text="{backend>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                            <!-- Factura Date -->
                            <Text id="txtFacturaDateCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/Date/Value/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Creation Date -->
                            <Text id="txtCreationDateCell" text="{
                                path: 'backend>History/Created/Date/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Dispatch Date -->
                            <Text id="txtDispatchDateCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/SendDate/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Transfer Format -->
                            <Text id="txtTransferFormatCell" text="{backend>MetaData/Object/Data/Basics/TransferFormat}" />

                            <!-- Delivery Method -->
                            <Text id="txtDeliveryMethodCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/DeliveryMethod',
                                formatter: '.formatter.formatDeliveryMethod'
                            }" />

                            <!-- Delivery ID -->
                            <Text id="txtDeliveryIdCell" text="{backend>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                            <!-- PDF -->
                            <Text id="txtPdfCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                formatter: '.formatter.formatPdf'
                            }" />

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </f:content>
    </f:DynamicPage>

</mvc:View>
