<mvc:View
    controllerName="billing.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants">

    <f:DynamicPage
        id="dpBilling"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true"
        >

        <!-- ====== TITLE AREA (immer sichtbar) ====== -->
        <f:title>
            <f:DynamicPageTitle id="dptTitle">

                <f:heading>
                    <svm:SmartVariantManagement id="svm" showExecuteOnSelection="true" />
                </f:heading>
                	<f:expandedContent>
						<Label id="expandedLabel" text="No filters active" />
					</f:expandedContent>
					<f:snappedContent>
						<Label id="snappedLabel" text="No filters active" />
					</f:snappedContent>

                <!-- Actions rechts wie vorher im OverflowToolbar -->
                <f:actions>

                    <Button
                        id="btnCreate"
                        text="Create"
                        type="Emphasized"
                        class="myCreateBtn"
                        press=".onCreate" />

                    <Button
                        id="btnDelete"
                        icon="sap-icon://delete"
                        press=".onDelete"
                        tooltip="Delete selected"
                        enabled="false" />

                    <Button
                        id="btnRefresh"
                        icon="sap-icon://refresh"
                        press="onReload"
                        type="Transparent" />

                    <Button
                        id="btnSettings"
                        icon="sap-icon://action-settings"
                        press=".onSettings" />
                </f:actions>

            </f:DynamicPageTitle>
        </f:title>

        <!-- ====== COLLAPSIBLE / PINNABLE HEADER ====== -->
        <f:header>
            <f:DynamicPageHeader id="dphHeader" pinnable="true">
                <f:content>

                <Button text="Clear Filters" type="Transparent" press=".onClearFilters"/>
                                                      
                <!-- Hier ist der Bereich wie im Screenshot (Filter + Search) -->
               <fb:FilterBar id="filterbar" persistencyKey="myPersKey" 
               useToolbar="false" search=".onSearch" 
               filterChange=".onFilterChange" 
               afterVariantLoad=".onAfterVariantLoad"
               >
                    <fb:filterGroupItems>

                        <!-- Globale Suche  -->
                        <fb:FilterGroupItem
                            id="fgiQuickSearch"
                            groupName="Group1"
                            name="Search"
                            label="Search"
                            visibleInFilterBar="true">
                            <fb:control>
                                <SearchField
                                    id="sfSearch"
                                    width="18rem"
                                    placeholder="Search"
                                    change = ".onAddFilter"
                                    search=".onAddFilter" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- ====== Status ====== -->
                        <fb:FilterGroupItem
                            id="fgiStatus"
                            name="State"
                            label="Status"
                            groupName="Group1"
                            visibleInFilterBar="true">
                            <fb:control>
                            <MultiComboBox
                            id="mcbStatus"
                            name="State"
                            selectionChange=".onAddFilter"
                            items="{ path: 'fb>/StatusList', templateShareable: true }">
                            <core:Item id ="State" key="{fb>key}" text="{fb>text}" />
                            </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <!-- ====== Recipient name ====== -->
                        <fb:FilterGroupItem
                            id="fgiRecipientName"
                            name="RecipientName"
                            label="Recipient Name"
                            groupName="Group1"
                            visibleInFilterBar="true">
                            <fb:control>
                                <SearchField
                                        id="sfRecipientName"
                                        width="50%"
                                        placeholder="Recipient Name"
                                        enableSuggestions="true"
                                        search=".onAddFilter"
                                        suggest=".onSuggest"
                                        suggestionItems="{
                                            path: 'fb>/RecipientNameList',
                                            sorter: { path: 'text' }
                                        }">
                                    <SuggestionItem text="{fb>text}" key="{fb>key}" />
                                    </SearchField>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- ====== Netto Betrag ====== -->
                        <fb:FilterGroupItem
                            id="fgiNettoValue"
                            name="NettoValue"
                            label="Netto Value"
                            groupName="Group1"
                            visibleInFilterBar="true">
                        <fb:control>
                            <SearchField
                                id="sfNettoValue"
                                width="50%"
                                placeholder="Netto Value"
                                search=".onAddFilter" 
                                change=".onAddFilter"/>
                        </fb:control>
                        </fb:FilterGroupItem>

                        <!-- ====== InvoiceNo ====== -->
                        <fb:FilterGroupItem
                        id="fgiInvoiceNo"
                        name="InvoiceNo"
                        label="Invoice No."
                        groupName="Group1"
                        visibleInFilterBar="true">
                        <fb:control>

                        <MultiInput
                            id="multiInputInvNo"
                            width="60%"
                            valueHelpRequest=".onValueHelpRequested"
                            tokenChange=".onAddFilter"
                            change=".onAddFilter"
                            suggestionRows="{
                                path: 'fb>/InvoiceNumberList',
                                length: 10
                            }">
                            <suggestionColumns>
                                <Column id="colSugInvNo">
                                    <Label id="lblSugInvNo" text="Invoice No."/>
                                </Column>
                                <Column id="colSugInvRecName">
                                    <Label id="lblSugInvRecName" text="Recipient Name"/>
                                </Column>
                            </suggestionColumns>

                            <suggestionRows>
                                <ColumnListItem id="cliSugInvNo">
                                    <Label id="lblSugInvNoVal" text="{fb>InvoiceNo}" />
                                    <Label id="lblSugInvRecNameVal" text="{fb>RecipientName}" />
                                </ColumnListItem>
                            </suggestionRows>
                        </MultiInput>

                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem
                        id="fgiFacturaDate"
                        name="FacturaDate"
                        label="Factura Date"
                        groupName="Group1"
                        visibleInFilterBar="true">
                    <fb:control>
                        <DateRangeSelection
                            id="drsFacturaDate"
                            displayFormat="dd.MM.yyyy"
                            showCurrentDateButton="true"
			                showFooter="true"
                            valueFormat="yyyy-MM-dd"
                            change=".onFacturaDateChange"
                            parseError=".onFacturaDateParseError"
                            class="facturaDateSmallText"/>
                    </fb:control>
                    </fb:FilterGroupItem>
                        
                    </fb:filterGroupItems>
                </fb:FilterBar>
        </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- ====== CONTENT ====== -->
        <f:content>

            <Table
                id="tblBilling"
                inset="false"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                mode="MultiSelect"
                items="{backend>/value}"
                itemPress=".onInvoicePress"
                selectionChange=".onSelectionChange">
            <infoToolbar>
				<OverflowToolbar id="vsdFilterBar" visible="false">
					<Text id="vsdFilterLabel" />
				</OverflowToolbar>
			</infoToolbar>
                <columns>
                <!-- Status -->
                <Column id="colStatus" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="State" writeToDom="false"/>
                    </customData>
                    <Text id="txtColStatus" text="Status"/>
                </Column>

                <!-- Recipient Name -->
                <Column id="colRecipientName" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Recipient/Name" writeToDom="false"/>
                    </customData>
                    <Text id="txtColRecipientName" text="Recipient Name"/>
                </Column>

                <!-- Recipient Email -->
                <Column id="colRecipientEmail" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Recipient/Email/0/Address" writeToDom="false"/>
                    </customData>
                    <Text id="txtColRecipientEmail" text="Recipient Email"/>
                </Column>

                <!-- Invoice Type (formatter in cell -> sort by raw Type) -->
                <Column id="colInvoiceType" hAlign="Center" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Type" writeToDom="false"/>
                    </customData>
                    <Text id="txtColInvoiceType" text="Invoice Type"/>
                </Column>

                <!-- Invoice No. -->
                <Column id="colInvoiceNo" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Number/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColInvoiceNo" text="Invoice No."/>
                </Column>

                <!-- Netto Value -->
                <Column id="colNettoValue" hAlign="End" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Net/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColNettoValue" text="Netto Value"/>
                </Column>

                <!-- Brutto Value -->
                <Column id="colBruttoValue" hAlign="End" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Gross/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColBruttoValue" text="Brutto Value"/>
                </Column>

                <!-- CCY -->
                <Column id="colCcy" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Amounts/Currency/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColCcy" text="CCY"/>
                </Column>

                <!-- Sales Org -->
                <Column id="colSalesOrg" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColSalesOrg" text="Sales Org"/>
                </Column>

                <!-- Factura Date -->
                <Column id="colFacturaDate" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/Date/Value/$date" writeToDom="false"/>
                    </customData>
                    <Text id="txtColFacturaDate" text="Factura Date"/>
                </Column>

                <!-- Creation Date -->
                <Column id="colCreationDate" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="History/Created/Date/$date" writeToDom="false"/>
                    </customData>
                    <Text id="txtColCreationDate" text="Creation Date"/>
                </Column>

                <!-- Dispatch Date -->
                <Column id="colDispatchDate" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/SendDate/$date" writeToDom="false"/>
                    </customData>
                    <Text id="txtColDispatchDate" text="Dispatch Date"/>
                </Column>

                <!-- Transfer Format -->
                <Column id="colTransferFormat" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/TransferFormat" writeToDom="false"/>
                    </customData>
                    <Text id="txtColTransferFormat" text="Transfer Format"/>
                </Column>

                <!-- Delivery Method (formatter in cell -> sort by raw DeliveryMethod) -->
                <Column id="colDeliveryMethod" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/DeliveryMethod" writeToDom="false"/>
                    </customData>
                    <Text id="txtColDeliveryMethod" text="Delivery Method"/>
                </Column>

                <!-- Delivery ID -->
                <Column id="colDeliveryId" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value" writeToDom="false"/>
                    </customData>
                    <Text id="txtColDeliveryId" text="Delivery ID"/>
                </Column>

                <!-- PDF (formatter in cell -> sort by raw TransferFormat) -->
                <Column id="colPdf" headerMenu="columnHeaderMenu">
                    <customData>
                    <core:CustomData key="sortKey" value="MetaData/Object/Data/Basics/TransferFormat" writeToDom="false"/>
                    </customData>
                    <Text id="txtColPdf" text="PDF"/>
                </Column>
                </columns>


                <items>
                    <ColumnListItem id="cliBilling" type="Active">
                        <cells>

                            <!-- Status -->
                            <ObjectStatus
                                id="osState"
                                text=""
                                icon="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusIcon'
                                }"
                                state="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusState'
                                }"
                            />

                            <!-- Recipient Name -->
                            <Text id="txtRecipientName" text="{backend>MetaData/Object/Data/Basics/Recipient/Name}" />

                            <!-- Recipient Email -->
                            <Text id="txtRecipientEmail" text="{backend>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />

                            <!-- Invoice Type -->
                            <Text id="txtInvoiceType" text="{
                                path: 'backend>MetaData/Object/Data/Type',
                                formatter: '.formatter.formatInvoiceType'
                            }" />

                            <!-- Invoice No. -->
                            <Text id="txtInvoiceNo" text="{backend>MetaData/Object/Data/Basics/Number/Value}" />

                            <!-- Netto -->
                            <ObjectNumber
                                id="onNetto"
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Net/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- Brutto -->
                            <ObjectNumber
                                id="onBrutto"
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Gross/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- CCY -->
                            <Text id="txtCcyCell" text="{
                                path: 'backend>MetaData/Object/Data/Amounts/Currency/Value',
                                formatter: '.formatter.formatCurrency'
                            }" />

                            <!-- Sales Org -->
                            <Text id="txtSalesOrgCell" text="{backend>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                            <!-- Factura Date -->
                            <Text id="txtFacturaDateCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/Date/Value/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Creation Date -->
                            <Text id="txtCreationDateCell" text="{
                                path: 'backend>History/Created/Date/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Dispatch Date -->
                            <Text id="txtDispatchDateCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/SendDate/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Transfer Format -->
                            <Text id="txtTransferFormatCell" text="{backend>MetaData/Object/Data/Basics/TransferFormat}" />

                            <!-- Delivery Method -->
                            <Text id="txtDeliveryMethodCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/DeliveryMethod',
                                formatter: '.formatter.formatDeliveryMethod'
                            }" />

                            <!-- Delivery ID -->
                            <Text id="txtDeliveryIdCell" text="{backend>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                            <!-- PDF -->
                            <Text id="txtPdfCell" text="{
                                path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                formatter: '.formatter.formatPdf'
                            }" />

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </f:content>
    </f:DynamicPage>

</mvc:View>
