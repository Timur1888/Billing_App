<mvc:View controllerName="billing.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="page" title="{i18n>title}">
        
        <customHeader>
            
            <OverflowToolbar id="otbHeader">
                <Title id="hdrTitle" text="Billing"/>

            <!-- Button wie im Screenshot: zeigt aktuelle Ansicht -->
            <Button
                id="btnVariants"
                type="Transparent"
                icon="sap-icon://dropdown"
                text="{variant>/currentViewName}"
                press=".onOpenVariantPopover"
                class="sapUiTinyMarginBegin"/>

                <Button id="btnCreate" text="Create" type="Emphasized"
                        class="myCreateBtn" press=".onCreate"/>
                <Button id="btnDelete" icon="sap-icon://delete" press=".onDelete"
                        tooltip="Delete selected" enabled="false"/>
                <Button icon="sap-icon://refresh" press="onReload" type="Transparent"/>

                <ToolbarSpacer id="hdrSpacer"/>

                <Button id="btnSettings" icon="sap-icon://action-settings" press=".onSettings"/>
                <Button id="btnFilter" icon="sap-icon://filter" press=".onFilter"/>

                <SearchField id="sfSearch"
                    width="18rem"
                    placeholder="Search"
                    search=".onSearch" />
            </OverflowToolbar>
        </customHeader>

        <content>

            <!-- Aktive Filter-Chips -->
            <Tokenizer
                id="filterTokenizer"
                visible="false"
                editable="true"
                tokenChange=".onFilterTokenChange"
                class="sapUiSmallMargin" />

            <Table
                id="tblBilling"
                inset="false"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                mode="MultiSelect"
                items="{backend>/value}"
                itemPress=".onInvoicePress"
                selectionChange=".onSelectionChange">

                <columns>
                    <Column><Text text="Status"/></Column>
                    <Column><Text text="Recipient Name"/></Column>
                    <Column><Text text="Recipient Email"/></Column>
                    <Column hAlign="Center"><Text text="Invoice Type"/></Column>
                    <Column><Text text="Invoice No."/></Column>
                    <Column hAlign="End"><Text text="Netto Value"/></Column>
                    <Column hAlign="End"><Text text="Brutto Value"/></Column>
                    <Column><Text text="CCY"/></Column>
                    <Column><Text text="Sales Org"/></Column>
                    <Column><Text text="Factura Date"/></Column>
                    <Column><Text text="Creation Date"/></Column>
                    <Column><Text text="Dispatch Date"/></Column>
                    <Column><Text text="Transfer Format"/></Column>
                    <Column><Text text="Delivery Method"/></Column>
                    <Column><Text text="Delivery ID"/></Column>
                    <Column><Text text="PDF"/></Column>
                </columns>

                <items>
                    <ColumnListItem type="Active">
                        <cells>

                            <!-- Status -->
                            <ObjectStatus
                                text=""
                                icon="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusIcon'
                                }"
                                state="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusState'
                                }"
                            />

                            <!-- Recipient Name -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Recipient/Name}" />

                            <!-- Recipient Email -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />

                            <!-- Invoice Type -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Type',
                                formatter: '.formatter.formatInvoiceType'
                            }" />

                            <!-- Invoice No. -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Number/Value}" />

                            <!-- Netto -->
                            <ObjectNumber
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Net/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- Brutto -->
                            <ObjectNumber
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Gross/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- CCY -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Amounts/Currency/Value',
                                formatter: '.formatter.formatCurrency'
                            }" />

                            <!-- Sales Org -->
                            <Text text="{backend>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                            <!-- Factura Date -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/Date/Value/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Creation Date -->
                            <Text text="{
                                path: 'backend>History/Created/Date/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Dispatch Date -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/SendDate/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Transfer Format -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                formatter: '.formatter.formatTransferFormat'
                                }" />

                            <!-- Delivery Method -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/DeliveryMethod',
                                formatter: '.formatter.formatDeliveryMethod'
                            }" />

                            <!-- Delivery ID -->
                            <Text text="{backend>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                            <!-- PDF -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                formatter: '.formatter.formatPdf'
                            }" />

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>

</mvc:View>
