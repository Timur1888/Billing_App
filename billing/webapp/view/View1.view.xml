<mvc:View
    controllerName="billing.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar">

    <f:DynamicPage
        id="dpBilling"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true">

        <!-- ====== TITLE AREA (immer sichtbar) ====== -->
        <f:title>
            <f:DynamicPageTitle id="dptTitle">

                <f:heading>
                    <Title id="hdrTitle" text="Billing" />
                </f:heading>

                <!-- Actions rechts wie vorher im OverflowToolbar -->
                <f:actions>

                    <Button
                        id="btnCreate"
                        text="Create"
                        type="Emphasized"
                        class="myCreateBtn"
                        press=".onCreate" />

                    <Button
                        id="btnDelete"
                        icon="sap-icon://delete"
                        press=".onDelete"
                        tooltip="Delete selected"
                        enabled="false" />

                    <Button
                        icon="sap-icon://refresh"
                        press="onReload"
                        type="Transparent" />

                    <Button
                        id="btnSettings"
                        icon="sap-icon://action-settings"
                        press=".onSettings" />
                </f:actions>

            </f:DynamicPageTitle>
        </f:title>

        <!-- ====== COLLAPSIBLE / PINNABLE HEADER ====== -->
        <f:header>
            <f:DynamicPageHeader id="dphHeader" pinnable="true">

                <!-- Hier ist der Bereich wie im Screenshot (Filter + Search) -->
                <fb:FilterBar
                    id="fbBilling"
                    showGoOnFB="true"
                    showClearOnFB="true"
                    filterBarExpanded="true"
                    search=".onSearch"
                    clear=".onClear">

                    <fb:filterGroupItems>

                        <!-- Quick Search (entspricht deinem SearchField) -->
                        <fb:FilterGroupItem
                            groupName="Group1"
                            name="q"
                            label="Search">
                            <fb:control>
                                <SearchField
                                    id="sfSearch"
                                    width="18rem"
                                    placeholder="Search"
                                    search=".onSearch" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- Beispiel-Filterfeld (kannst du ersetzen/erweitern) -->
								<fb:FilterGroupItem name="Status" label="Status" groupName="Group1" visibleInFilterBar="true">
									<fb:control>
										<MultiComboBox
											name="Status"
											selectionChange=".onFilterSelectionChange"
											items="{
												path: 'backend>/value',
												templateShareable: true
											}"
										>
											<core:Item key="{key}" text="{name}"/>
										</MultiComboBox>
									</fb:control>
								</fb:FilterGroupItem>

                    </fb:filterGroupItems>
                </fb:FilterBar>

            </f:DynamicPageHeader>
        </f:header>

        <!-- ====== CONTENT ====== -->
        <f:content>

            <Table
                id="tblBilling"
                inset="false"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                mode="MultiSelect"
                items="{backend>/value}"
                itemPress=".onInvoicePress"
                selectionChange=".onSelectionChange">

                <columns>
                    <Column><Text text="Status"/></Column>
                    <Column><Text text="Recipient Name"/></Column>
                    <Column><Text text="Recipient Email"/></Column>
                    <Column hAlign="Center"><Text text="Invoice Type"/></Column>
                    <Column><Text text="Invoice No."/></Column>
                    <Column hAlign="End"><Text text="Netto Value"/></Column>
                    <Column hAlign="End"><Text text="Brutto Value"/></Column>
                    <Column><Text text="CCY"/></Column>
                    <Column><Text text="Sales Org"/></Column>
                    <Column><Text text="Factura Date"/></Column>
                    <Column><Text text="Creation Date"/></Column>
                    <Column><Text text="Dispatch Date"/></Column>
                    <Column><Text text="Transfer Format"/></Column>
                    <Column><Text text="Delivery Method"/></Column>
                    <Column><Text text="Delivery ID"/></Column>
                    <Column><Text text="PDF"/></Column>
                </columns>

                <items>
                    <ColumnListItem type="Active">
                        <cells>

                            
                            <!-- Status -->
                            <ObjectStatus
                                text=""
                                icon="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusIcon'
                                }"
                                state="{
                                    path: 'backend>State',
                                    formatter: '.formatter.formatStatusState'
                                }"
                            />
                            <!-- Recipient Name -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Recipient/Name}" />

                            <!-- Recipient Email -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />

                            <!-- Invoice Type -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Type',
                                formatter: '.formatter.formatInvoiceType'
                            }" />

                            <!-- Invoice No. -->
                            <Text text="{backend>MetaData/Object/Data/Basics/Number/Value}" />

                            <!-- Netto -->
                            <ObjectNumber
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Net/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- Brutto -->
                            <ObjectNumber
                                number="{
                                    path: 'backend>MetaData/Object/Data/Amounts/Gross/Value',
                                    formatter: '.formatter.formatCurrencyValue'
                                }" />

                            <!-- CCY -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Amounts/Currency/Value',
                                formatter: '.formatter.formatCurrency'
                            }" />

                            <!-- Sales Org -->
                            <Text text="{backend>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                            <!-- Factura Date -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/Date/Value/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Creation Date -->
                            <Text text="{
                                path: 'backend>History/Created/Date/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Dispatch Date -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/SendDate/$date',
                                formatter: '.formatter.formatDate'
                            }" />

                            <!-- Transfer Format -->
                            <Text text="{backend>MetaData/Object/Data/Basics/TransferFormat}" />

                            <!-- Delivery Method -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/DeliveryMethod',
                                formatter: '.formatter.formatDeliveryMethod'
                            }" />

                            <!-- Delivery ID -->
                            <Text text="{backend>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                            <!-- PDF -->
                            <Text text="{
                                path: 'backend>MetaData/Object/Data/Basics/TransferFormat',
                                formatter: '.formatter.formatPdf'
                            }" />

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </f:content>
    </f:DynamicPage>

</mvc:View>
