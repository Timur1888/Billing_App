<mvc:View controllerName="billing.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">

  <customHeader>
  <OverflowToolbar id="otbHeader">
    <Title id="hdrTitle" text="Billing"/>

    <Button id="btnCreate" text="Create" type="Emphasized"
            class="myCreateBtn" press=".onCreate"/>
    <Button id="btnDelete" icon="sap-icon://delete" press=".onDelete"
            tooltip="Delete selected"/>
    <Button icon="sap-icon://refresh" press="onReload" type="Transparent"/>



    <ToolbarSpacer id="hdrSpacer"/>
      <!-- Icons links von der Suche -->
    <Button id="btnSettings" icon="sap-icon://action-settings" press=".onSettings"/>
    <Button id="btnFilter" icon="sap-icon://filter" press=".onFilter"/>
    <SearchField
        id="sfSearch"
        width="18rem"
        placeholder="Search"
        search=".onSearch" />
  </OverflowToolbar>
</customHeader>
 <content>

    <!-- Aktive Filter-Chips -->
    <Tokenizer
        id="filterTokenizer"
        visible="false"
        editable="true"
        tokenChange=".onFilterTokenChange"
        class="sapUiSmallMargin" />


    <Table
      id="tblBilling"
      inset="false"
      alternateRowColors="true"
      sticky="ColumnHeaders"

      mode="MultiSelect"
      items="{testData>/value}"
      itemPress=".onInvoicePress">
            <columns>
                <Column><Text text="Status"/></Column>
                <Column><Text text="Recipient Name"/></Column>
                <Column><Text text="Recipient Email"/></Column>
                <Column hAlign="Center"><Text text="Invoice Type"/></Column>
                <Column><Text text="Invoice No."/></Column>
                <Column hAlign="End"><Text text="Netto Value"/></Column>
                <Column hAlign="End"><Text text="Brutto Value"/></Column>
                <Column><Text text="CCY"/></Column>
                <Column><Text text="Sales Org"/></Column>
                <Column><Text text="Factura Date"/></Column>
                <Column><Text text="Creation Date"/></Column>
                <Column><Text text="Dispatch Date"/></Column>
                <Column><Text text="Transfer Format"/></Column>
                <Column><Text text="Delivery Method"/></Column>
                <Column><Text text="Delivery ID"/></Column>
                <Column><Text text="PDF"/></Column>
            </columns>

            <!-- Zellen / Items (an Mockdaten gebunden) -->
                        <items>
                <ColumnListItem type="Active">
                <cells>
                    <!-- Status -->
                   <ObjectStatus
                        text=""
                        icon="{
                            path: 'testData>State',
                            formatter: '.formatStatusIcon'
                        }"
                        state="{
                            path: 'testData>State',
                            formatter: '.formatStatusState'
                        }"
                    />

                    <!-- Recipient Name -->
                    <Text text="{testData>MetaData/Object/Data/Basics/Recipient/Name}" />

                    <!-- Recipient Email -->
                    <Text text="{testData>MetaData/Object/Data/Basics/Recipient/Email/0/Address}" />

                    <!-- Invoice Type -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Type',
                    formatter: '.formatInvoiceType'
                    }" />

                    <!-- Invoice No. -->
                    <Text text="{testData>MetaData/Object/Data/Basics/Number/Value}" />

                    <!-- Netto / Brutto -->
                    <ObjectNumber
                    number="{
                        path: 'testData>MetaData/Object/Data/Amounts/Net/Value',
                        formatter: '.formatCurrencyValue'
                    }" />
                    <ObjectNumber
                        number="{
                            path: 'testData>MetaData/Object/Data/Amounts/Gross/Value',
                            formatter: '.formatCurrencyValue'
                        }" />

                    <!-- CCY -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Amounts/Currency/Value',
                    formatter: '.formatCurrency'
                    }" />

                    <!-- Sales Org (erster BusinessPartner) -->
                    <Text text="{testData>MetaData/Object/Data/BusinessPartners/0/SalesOrganisation/Value}" />

                    <!-- Creation Date -->
                    <Text text="{
                    path: 'testData>History/Created/Date/$date',
                    formatter: '.formatDate'
                    }" />

                    <!-- Factura Date -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Basics/Date/Value/$date',
                    formatter: '.formatDate'
                    }" />

                    <!-- Dispatch Date -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Basics/SendDate/$date',
                    formatter: '.formatDate'
                    }" />

                    <!-- Transfer Format -->
                    <Text text="{testData>MetaData/Object/Data/Basics/TransferFormat}" />

                    <!-- Delivery Method -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Basics/DeliveryMethod',
                    formatter: '.formatDeliveryMethod'
                    }" />

                    <!-- Leitweg ID (z. B. zweiter Partner) -->
                    <Text text="{testData>MetaData/Object/Data/BusinessPartners/1/LeitwegId/Value}" />

                    <!-- PDF -->
                    <Text text="{
                    path: 'testData>MetaData/Object/Data/Basics/TransferFormat',
                    formatter: '.formatPdf'
                    }" />
                </cells>
                </ColumnListItem>
            </items>
    </Table>
</content>
    </Page>
</mvc:View>