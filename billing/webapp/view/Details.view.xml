<?xml version="1.0" encoding="UTF-8"?>
<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:unified="sap.ui.unified" xmlns:upload="sap.m.upload" controllerName="billing.controller.Details">
   <Page title="Invoice {backend>MetaData/Object/Data/Basics/Number/Value}" showFooter="true">
      <!-- X-Schließen-Button rechts oben -->
      <headerContent>
         <Button id="btnClose" icon="sap-icon://decline" type="Transparent" tooltip="Close" press=".onClose" class="detailCloseBtn" />
      </headerContent>
      <content>
         <!-- Tabs: Overview / History -->
         <IconTabBar id="itbDetails" expanded="true" upperCase="false" selectedKey="overview" select=".onIconTabSelect">
            <items>
               <!-- ================== OVERVIEW TAB ================== -->
               <IconTabFilter key="overview" text="Overview">
                  <!-- ==========================================
                     PDF direkt im Panel + Klick öffnet Popup
                     ========================================== -->
                  <VBox class="sapUiSmallMargin">
                     <Title text="Invoice Files" level="H3" class="sapUiTinyMarginBottom"/>
                    <Carousel
                        id="blobCarousel"
                        class="sapUiContentPadding pdfCarousel"
                        loop="false"
                        pageChanged=".onBlobPageChanged"
                        pages="{backend>/CurrentInvoice/BlobItems}">
                    <pages>
                        <VBox width="100%" class="pdfPageScroll">

                        <!-- Preview vorhanden (PDF-Preview ODER Bild-Link) -->
                        <Image
                            src="{backend>previewLink}"
                            alt="{backend>fileName}"
                            width="100%"
                            decorative="false"
                            densityAware="false"
                            press=".onFilePress"
                            visible="{= !!${backend>previewLink} }" />

                        <!-- Keine Preview -> Placeholder -->
                        <VBox
                            width="100%"
                            class="pdfPageScroll"
                            alignItems="Center"
                            justifyContent="Center"
                            visible="{= !${backend>previewLink} }">
                            <core:Icon src="{backend>icon}" size="4rem" />
                            <Text text="{backend>fileName}" class="sapUiSmallMarginTop"/>
                            <Link text="{backend>openText}" press=".onFilePress" class="sapUiSmallMarginTop"/>
                        </VBox>

                        </VBox>
                    </pages>
                    </Carousel>
                  </VBox>
                  <VBox width="100%" class="sapUiSmallMargin">
                     <!-- Invoice File -->
                     <VBox class="sapUiSmallMarginTop" width="97%">
                        <Title text="Upload (Invoice)" level="H4" />
                        <upload:UploadSet id="uploadSetInvoice" instantUpload="false" uploadEnabled="true" multiple="false" showIcons="true" terminationEnabled="false" fileTypes="pdf,png,jpg,jpeg" items="{backend&gt;/CurrentInvoice/InvoiceBlobs}" afterItemAdded=".onInvoiceItemAdded" beforeUploadStarts=".onInvoiceBeforeUploadStarts" uploadCompleted=".onInvoiceUploadCompleted" afterItemRemoved=".onAfterInvoiceItemRemoved">
                           <!-- Wie ein List-Template: -->
                           <upload:items>
                              <upload:UploadSetItem fileName="{backend&gt;FileName}" mediaType="{backend&gt;MimeType}" url="{backend&gt;DownloadUrl}" visibleEdit="false" visibleRemove="true" />
                           </upload:items>
                        </upload:UploadSet>
                     </VBox>
                     <!-- Attachments -->
                     <VBox class="sapUiSmallMarginTop" width="97%">
                        <Title text="Upload (Attachments)" level="H4" />
                        <upload:UploadSet id="uploadSetAttachments" instantUpload="false" uploadEnabled="true" multiple="true" showIcons="true" terminationEnabled="false" fileTypes="pdf,png,jpg,jpeg" items="{backend&gt;/CurrentInvoice/AttachmentBlobs}" afterItemAdded=".onAttachmentItemAdded" beforeUploadStarts=".onAttachmentBeforeUploadStarts" uploadCompleted=".onAttachmentUploadCompleted" afterItemRemoved=".onAfterAttachmentItemRemoved">
                           <upload:items>
                              <upload:UploadSetItem fileName="{backend&gt;FileName}" mediaType="{backend&gt;MimeType}" url="{backend&gt;DownloadUrl}" visibleEdit="false" visibleRemove="true" />
                           </upload:items>
                        </upload:UploadSet>
                     </VBox>
                     <!-- Output -->
                     <Title text="Output" level="H4" class="sapUiMediumMarginTop" />
                     <VBox class="sapUiSmallMarginTop" width="97%">
                        <Select width="100%" class="sapUiSmallMarginBottom">
                           <items>
                              <core:Item key="transF" text="Transfer Format" />
                              <core:Item key="fx" text="Factur-X" />
                              <core:Item key="pdf" text="PDF" />
                           </items>
                        </Select>
                        <Select width="100%" class="sapUiSmallMarginBottom">
                           <items>
                              <core:Item key="delMeth" text="Delivery Method" />
                              <core:Item key="email" text="Email" />
                              <core:Item key="post" text="Postal Service" />
                           </items>
                        </Select>
                        <Input placeholder="Receiver" class="sapUiSmallMarginBottom" />
                        <Input placeholder="CC" class="sapUiSmallMarginBottom" />
                        <Input placeholder="BCC" class="sapUiSmallMarginBottom" />
                     </VBox>
                     <!-- Job Settings -->
                     <Title text="Job Settings" level="H4" class="sapUiMediumMarginTop" />
                     <HBox class="sapUiSmallMarginTop" alignItems="Center">
                        <Switch state="true" customTextOn="" customTextOff="" class="sapUiTinyMarginEnd" />
                        <Text text="Manual Dispatch" />
                     </HBox>
                     <!-- Templates -->
                     <Title text="Templates" level="H4" class="sapUiMediumMarginTop" />
                     <VBox class="sapUiSmallMarginTop">
                        <Label text="Subject" />
                        <Button text="Edit" type="Emphasized" class="sapUiTinyMarginTop" width="3rem" press=".onEditTemplate" />
                     </VBox>
                  </VBox>
               </IconTabFilter>
               <!-- ================== HISTORY TAB ================== -->
               <IconTabFilter key="history" text="History">
               <VBox class="sapUiSmallMargin" width="100%">

                  <List
                     id="lstHistory"
                     width="100%"
                     items="{history>/logs}"
                     noDataText="No history entries."
                     growing="true"
                     growingScrollToLoad="true"
                     showSeparators="Inner">

                     <CustomListItem>
                     <VBox width="100%" class="sapUiTinyMarginTop sapUiTinyMarginBottom">

                        <!-- 1. Zeile: Message links, Status rechts -->
                        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center">
                           <Text
                           text="{history>message}"
                           wrapping="true"
                           maxLines="2" />

                           <ObjectStatus
                           text="{history>statusText}"
                           state="{history>statusState}"
                           inverted="true"
                           class="sapUiTinyMarginBegin" />
                        </HBox>

                        <!-- 2. Zeile: Datum | Code -->
                        <Text
                        text="{parts: [{path:'history>date'}, {path:'history>code'}], formatter: '.formatHistoryMeta'}"
                        wrapping="false"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom sapUiSmallMarginBottom sapUiTinyMarginBegin"
                        />

                     </VBox>
                     </CustomListItem>

                  </List>
               </VBox>
               </IconTabFilter>

            </items>
         </IconTabBar>
      </content>
      <!-- Footer mit Save / Send -->
      <footer>
         <Toolbar>
            <ToolbarSpacer />
            <Button text="Save" type="Transparent" />
            <Button text="Send" type="Emphasized" class="sendButton" />
         </Toolbar>
      </footer>
   </Page>
</mvc:View>