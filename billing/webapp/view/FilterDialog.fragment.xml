<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="filterDialog"
        title="Select Filter"
        icon="sap-icon://message-information"
        horizontalScrolling="false"
        verticalScrolling="true"
        contentWidth="38rem">

        <content>
            <VBox class="sapUiLargeMargin">
                <!-- Container für alle Filter-Zeilen -->
                <VBox id="filtersContainer"/>
            </VBox>
        </content>

        <beginButton>
            <Button text="Cancel" press=".onFilterDialogCancel"/>
        </beginButton>

        <endButton>
            <Button text="Save" type="Emphasized" press=".onFilterDialogSave"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
